# .env.example
# -------------
# Enterprise Knowledge Intelligence Platform (EKIP) — Placement Edition v1.0
#
# Copy this file to .env and fill in the values for your environment.
# Never commit .env to version control.
#
# Usage:
#   cp .env.example .env      (Linux/macOS)
#   copy .env.example .env    (Windows)
#   # then edit .env with your actual secrets

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="Enterprise Knowledge Intelligence Platform"
APP_ENV=development          # development | staging | production
APP_DEBUG=false
APP_VERSION=1.0.0

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
SECRET_KEY=change-me-to-a-secure-random-string-at-least-32-chars
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Database
# Default: SQLite (ekip.db) — no additional config needed for local dev.
# For production PostgreSQL, uncomment and set the connection string:
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/ekip_db

# ---------------------------------------------------------------------------
# AI / LLM — Required for RAG and Semantic Search
# ---------------------------------------------------------------------------
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ---------------------------------------------------------------------------
# Vector Store
# Default: ChromaDB persisted locally in chroma_db/ — no additional config needed.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# File Storage
# ---------------------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20
